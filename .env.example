# Anthropic API 키. https://console.anthropic.com 에서 발급.
# Managed Agents는 베타 기능이라 결제가 활성화된 워크스페이스가 필요합니다.
ANTHROPIC_API_KEY=sk-ant-...

# 백엔드 포트 (기본 8787). 상위 도구가 PORT를 주입해 Vite와 충돌하는 것을
# 막으려면 PORT 대신 API_PORT를 쓴다 — API_PORT가 PORT보다 우선한다.
API_PORT=8787

# 팀이 연동한 API 키를 암호화해 저장하기 위한 마스터 키(16자 이상).
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 주의: 이 값을 잃어버리면 저장된 키를 복호화할 수 없어 모두 재등록해야 합니다.
AIOFFICE_SECRET=
