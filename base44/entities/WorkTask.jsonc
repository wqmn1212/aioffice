{
  "name": "WorkTask",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "sales",
        "marketing",
        "development",
        "design",
        "hr",
        "operations"
      ]
    },
    "assignee": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "in_progress",
        "pending_approval",
        "completed",
        "cancelled"
      ],
      "default": "queued"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "result": {
      "type": "string"
    },
    "iteration": {
      "type": "number",
      "default": 1,
      "minimum": 1,
      "maximum": 3
    },
    "progress_rate": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    },
    "selected_model": {
      "type": "string",
      "default": "gemini_3_flash"
    }
  },
  "required": [
    "company_id",
    "goal_id",
    "title",
    "department",
    "status"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}