{
  "name": "Company",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "\ud68c\uc0ac \ub808\ucf54\ub4dc \uc790\uccb4 ID\uc640 \ub3d9\uc77c\ud55c \ud14c\ub10c\ud2b8 ID"
    },
    "name": {
      "type": "string"
    },
    "business_type": {
      "type": "string"
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "business_type",
    "departments"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}